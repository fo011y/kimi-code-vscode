{
  "name": "kimi-code",
  "displayName": "Kimi Code — AI-ассистент",
  "description": "Чат с Kimi (Moonshot AI) прямо в VS Code: чат-панель, действия с выделенным кодом, агентский режим с правками файлов и запуском команд.",
  "version": "0.8.0",
  "publisher": "kimi",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fo011y/kimi-code-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kimi",
          "title": "Kimi",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kimi": [
        {
          "id": "kimi.chatView",
          "name": "Kimi Чат",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "kimi.login",
        "title": "Kimi: Войти через сайт (OAuth)"
      },
      {
        "command": "kimi.logout",
        "title": "Kimi: Выйти из аккаунта"
      },
      {
        "command": "kimi.accountMenu",
        "title": "Kimi: Аккаунт и статус"
      },
      {
        "command": "kimi.showUsage",
        "title": "Kimi: Лимиты использования"
      },
      {
        "command": "kimi.setApiKey",
        "title": "Kimi: Указать API-ключ"
      },
      {
        "command": "kimi.newChat",
        "title": "Kimi: Новый диалог"
      },
      {
        "command": "kimi.setMode",
        "title": "Kimi: Выбрать режим автономности"
      },
      {
        "command": "kimi.setModel",
        "title": "Kimi: Выбрать модель"
      },
      {
        "command": "kimi.reviewChanges",
        "title": "Kimi: Изменения за сессию (откат)"
      },
      {
        "command": "kimi.sendSelectionToChat",
        "title": "Kimi: Отправить выделенное в чат"
      },
      {
        "command": "kimi.askAboutFile",
        "title": "Kimi: Спросить о текущем файле",
        "icon": "$(sparkle)"
      },
      {
        "command": "kimi.openInEditor",
        "title": "Kimi: Открыть чат в редакторе"
      },
      {
        "command": "kimi.focus",
        "title": "Kimi: Фокус на чат"
      },
      {
        "command": "kimi.showLogs",
        "title": "Kimi: Показать логи"
      },
      {
        "command": "kimi.explainSelection",
        "title": "Kimi: Объяснить выделенное"
      },
      {
        "command": "kimi.fixSelection",
        "title": "Kimi: Исправить выделенное"
      },
      {
        "command": "kimi.refactorSelection",
        "title": "Kimi: Отрефакторить выделенное"
      },
      {
        "command": "kimi.addTests",
        "title": "Kimi: Написать тесты для выделенного"
      },
      {
        "command": "kimi.editSelection",
        "title": "Kimi: Изменить выделенное по инструкции"
      }
    ],
    "keybindings": [
      {
        "command": "kimi.sendSelectionToChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "kimi.focus",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kimi.askAboutFile",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "kimi.explainSelection",
          "when": "editorHasSelection",
          "group": "kimi@1"
        },
        {
          "command": "kimi.fixSelection",
          "when": "editorHasSelection",
          "group": "kimi@2"
        },
        {
          "command": "kimi.refactorSelection",
          "when": "editorHasSelection",
          "group": "kimi@3"
        },
        {
          "command": "kimi.addTests",
          "when": "editorHasSelection",
          "group": "kimi@4"
        },
        {
          "command": "kimi.editSelection",
          "when": "editorHasSelection",
          "group": "kimi@5"
        }
      ]
    },
    "configuration": {
      "title": "Kimi Code",
      "properties": {
        "kimi.baseUrl": {
          "type": "string",
          "default": "https://api.moonshot.ai/v1",
          "description": "Базовый URL Moonshot API. Для Китая: https://api.moonshot.cn/v1"
        },
        "kimi.model": {
          "type": "string",
          "default": "kimi-k2-0905-preview",
          "description": "Модель Kimi (например kimi-k2-0905-preview, kimi-latest, moonshot-v1-32k)"
        },
        "kimi.temperature": {
          "type": "number",
          "default": 0.6,
          "description": "Температура генерации (0–1)"
        },
        "kimi.maxTokens": {
          "type": "number",
          "default": 8192,
          "description": "Максимум токенов в ответе"
        },
        "kimi.maxAgentSteps": {
          "type": "number",
          "default": 25,
          "description": "Максимум шагов агента за один цикл (после исчерпания срабатывает автопродолжение, см. kimi.maxAutoContinues)"
        },
        "kimi.maxAutoContinues": {
          "type": "number",
          "default": 50,
          "description": "Автопродолжение: сколько раз агент сам продолжает работу после исчерпания лимита шагов — работает до полного выполнения задачи, без остановок. 0 — выключить"
        },
        "kimi.permissionMode": {
          "type": "string",
          "enum": [
            "plan",
            "ask",
            "autoEdit",
            "fullAuto"
          ],
          "enumDescriptions": [
            "Режим планирования: Kimi только читает проект и составляет план, ничего не меняя",
            "Каждая правка файла и каждая команда требуют подтверждения",
            "Файлы изменяются без вопросов, команды в терминале — с подтверждением",
            "Всё без подтверждений: Kimi сам правит файлы и запускает команды"
          ],
          "default": "ask",
          "description": "Режим автономности агента (переключается также в панели чата)"
        },
        "kimi.autoPush": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически коммитить и пушить изменения на GitHub после выполнения задачи агентом (срабатывает, только если агент менял файлы)"
        },
        "kimi.deployCommand": {
          "type": "string",
          "default": "",
          "description": "Команда деплоя проекта, например: npm run build && npm run deploy, vercel --prod, netlify deploy --prod"
        },
        "kimi.autoDeploy": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически выполнять команду деплоя после задачи агента (после автопуша, если он включён; срабатывает, только если агент менял файлы)"
        },
        "kimi.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "Уважать .gitignore при обходе файлов агентом (list_files, search_in_files)"
        },
        "kimi.autoCompactTokens": {
          "type": "number",
          "default": 150000,
          "description": "Автоархивация контекста: при превышении этого размера промпта (в токенах) агент сжимает середину диалога в сводку и продолжает работу. 0 — выключить"
        },
        "kimi.autoNudgeSeconds": {
          "type": "number",
          "default": 90,
          "description": "Авто-пинок: если API не присылает ответ столько секунд, зависший запрос прерывается и агент продолжает с места остановки (до 3 попыток). Во время выполнения инструментов таймер на паузе. 0 — выключить"
        },
        "kimi.trustedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Дополнительные папки вне рабочей области, к которым агент получает доступ на чтение и запись (абсолютные пути, например D:\\Jobe\\1\\ipc-site)"
        },
        "kimi.attachSelection": {
          "type": "boolean",
          "default": true,
          "description": "Автоматически прикреплять выделенный код к сообщениям"
        },
        "kimi.attachOpenFile": {
          "type": "boolean",
          "default": false,
          "description": "Прикреплять открытый файл целиком, если нет выделения"
        },
        "kimi.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "Отправлять сообщение по Ctrl+Enter вместо Enter"
        },
        "kimi.showMessageTimestamps": {
          "type": "boolean",
          "default": false,
          "description": "Показывать метки времени у сообщений в чате"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.6.0"
  }
}
